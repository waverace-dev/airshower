{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "airshower": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server/server.mjs"],
      "cwd": "${PLUGIN_ROOT}",
